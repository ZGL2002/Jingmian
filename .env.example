# LLM 服务商与密钥：三选一
# 方案 A：DeepSeek（默认）
# DEEPSEEK_API_KEY=sk-请替换
# 方案 B：阿里云百炼（DashScope，OpenAI 兼容模式）
# INTERVIEW_PROVIDER=dashscope
# DASHSCOPE_API_KEY=sk-请替换
# INTERVIEW_MODEL=qwen-plus
# 方案 C：智谱（GLM，OpenAI 兼容模式；glm-4.7-flash 为免费档，模型名以控制台为准）
# INTERVIEW_PROVIDER=zhipu
# ZHIPU_API_KEY=sk-请替换
# INTERVIEW_MODEL=glm-4.7-flash
# 语音面试（Web 端语音模式）：需 DashScope key，与 LLM 提供商无关，
# DeepSeek 做对话 + DASHSCOPE_API_KEY 做语音识别/合成 可同时使用
# DASHSCOPE_API_KEY=sk-请替换
# ASR 识别模型（可选）：默认 paraformer-realtime-v2；
# 也可用 fun-asr-realtime / qwen-audio-3.0-asr-flash-streaming（qwen 系列必须带 -streaming 后缀）
# INTERVIEW_ASR_MODEL=paraformer-realtime-v2
# TTS 模型与音色（可选）：账号只有单一音色时配置 INTERVIEW_TTS_VOICE 即可，
# 四种风格共用该音色，风格差异由背景/人设/语速保留。
# 注意：音色不跨模型兼容——换 TTS 模型必须同时换成该模型音色表里的音色
# （cosyvoice 系列如 longshu_v2；qwen-audio-3.0-tts 系列如 longanfengyue/longanlingxin/longanlufeng）
# INTERVIEW_TTS_MODEL=cosyvoice-v2
# INTERVIEW_TTS_VOICE=
# 按风格单独覆盖（可选，优先级高于全局）：
# INTERVIEW_TTS_VOICE_SERIOUS=
# INTERVIEW_TTS_VOICE_COLD=
# INTERVIEW_TTS_VOICE_GENTLE=
# INTERVIEW_TTS_VOICE_GUIDE=
# 通用可选
# INTERVIEW_MIN_QUESTIONS=20
# INTERVIEW_LANG=zh
# INTERVIEW_ANSWER_OFFLOAD_THRESHOLD=100000
# INTERVIEW_CONTEXT_SAFETY_RATIO=0.8
# INTERVIEW_ROOT=interviews

# 简历 GitHub 项目深挖（可选）
# 检测到简历中的 github.com/<owner>/<repo> 链接时，面试立即开始（先问架构/选型），
# 代码审读子 agent 在后台并行读仓库；完成后分析注入面试官，面试中还能用
# list_github_files / read_github_file 追问代码细节。
# INTERVIEW_GITHUB_ANALYSIS=1        # 0 关闭
# INTERVIEW_GITHUB_MAX_REPOS=3       # 单场最多分析的仓库数
# GITHUB_TOKEN=                      # 可选：提升 API 限流额度（60/时 → 5000/时），私有仓库必填

# Web 服务（新增）
INTERVIEW_WEB_HOST=0.0.0.0
INTERVIEW_WEB_PORT=8765
# Web 访问口令：浏览器登录时输入；必填
INTERVIEW_WEB_TOKEN=请改成随机字符串
# 活跃面试空闲回收秒数（可选）
INTERVIEW_SESSION_IDLE_TIMEOUT=1800

# 飞书渠道（可选：启用 python -m interview_agent.feishu 时必填）
# 开放平台 → 企业自建应用 → 凭证与基础信息 中获取
FEISHU_APP_ID=cli_请替换
FEISHU_APP_SECRET=请替换
